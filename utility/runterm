# Configuration

## Where the launcher might be, best first: beside this script (the repo copy),
## then the local mirror of the synced tree, then the synced tree itself. On a Mac
## ~/synced is a Finder alias, which a shell cannot follow, so Dropbox is named too.
declare -r selfDir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
declare -ar launcherCandidates=(
	"${selfDir}/n8runterm.ps1"
	"/opt/0-0/common/exec/synced_local-copies/util/0_crossplatform/n8runterm.ps1"
	"${HOME}/synced/0-0/common/exec/util/0_crossplatform/n8runterm.ps1"
	"${HOME}/Dropbox/0-0/common/exec/util/0_crossplatform/n8runterm.ps1"
)

## Only for the no-pwsh case; the launcher has its own, longer list.
declare -ar fallbackTerminals=(silkterm terminator xfce4-terminal gnome-terminal konsole alacritty kitty xterm)


#••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••
# Functions

fMain(){

	local launcher=""
	local cand
	for cand in "${launcherCandidates[@]}"; do
		[[ -f "${cand}" ]] && { launcher="${cand}"; break; }
	done

	if [[ -z "${launcher}" ]]; then
		echo "runterm: n8runterm.ps1 not found (looked in: ${launcherCandidates[*]})" >&2
		fFallbackTerminal "${@}"
	fi

	if ! command -v pwsh >/dev/null 2>&1; then
		echo "runterm: PowerShell 7 (pwsh) is not installed; the launcher needs it" >&2
		fFallbackTerminal "${@}"
	fi

	exec pwsh -NoProfile -File "${launcher}" "${@}"
}


fFallbackTerminal(){
	local term
	for term in "${fallbackTerminals[@]}"; do
		if command -v "${term}" >/dev/null 2>&1; then
			echo "runterm: launching '${term}' instead" >&2
			exec "${term}"
		fi
	done
	echo "runterm: no terminal installed (${fallbackTerminals[*]})" >&2
	exit 1
}


#••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••
# Script entry point

 set -u  #..................: Require variable declaration.
 set -e  #..................: Exit on errors.
 set -E  #..................: Propagate ERR trap into functions and subshells.
 set   -o pipefail  #.......: Fail a pipe if any stage fails.
 shopt -s inherit_errexit 2>/dev/null || true  #: Propagate 'set -e' into command substitutions. Bash >=4.4; a Mac's own bash is 3.2.

[[ "${BASH_SOURCE[0]}" == "${0}" ]] || { echo -e "\nError in $(basename "${BASH_SOURCE[0]}"): Not meant to be 'sourced'.\n" >&2; return 1; }

fMain  "${@}"


