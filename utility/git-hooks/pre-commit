#!/bin/sh
# Keep staged Rust files rustfmt-clean before every commit (rustfmt.toml governs
# style; intentional data tables carry #[rustfmt::skip]). Formats what is STAGED
# and writes it back to the index, so a file with only some of its changes staged
# commits only those. The working tree is reformatted too, but only where it has
# nothing unstaged to lose.
#
# Activate once per clone:  git config core.hooksPath utility/git-hooks

