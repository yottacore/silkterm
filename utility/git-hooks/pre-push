#!/bin/sh
# Local merge gate: before any push that updates main, run the fast verify
# pass (cicd.bash --gate: fmt --check + clippy -D warnings + tests) against the
# commit being pushed, in a throwaway worktree.
# dev and feature branches are not gated. A branch is tested before it merges
# into dev, and running the whole pass again on the merge only cost time.
# Bypass for an emergency: git push --no-verify, or SKIP_GATE=1 git push.
#
# Activate once per clone:  git config core.hooksPath utility/git-hooks

