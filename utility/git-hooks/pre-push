set -eu

[ "${SKIP_GATE:-0}" = "1" ] && exit 0

# stdin: "<local_ref> <local_sha> <remote_ref> <remote_sha>" per ref being pushed.
gated=0
mainLocal=""
mainRemote=""
while read -r _ localSha remoteRef remoteSha; do
	case "${remoteRef}" in
		refs/heads/main)
			# deleting the branch pushes the zero sha - nothing to verify
			case "${localSha}" in *[!0]*) gated=1 ;; esac
			;;
	esac
	# main is release-only: remember its shas for the version-bump check below
	case "${remoteRef}" in
		refs/heads/main)
			case "${localSha}" in *[!0]*) mainLocal="${localSha}"; mainRemote="${remoteSha}" ;; esac
			;;
	esac
done

# Release guard: a push to main must strictly INCREASE the version. main is where
# releases are cut, so shipping the same-or-lower version is a mistake - block it
# here (before the slower gate) so a forgotten Cargo.toml bump can't reach main.
if [ -n "${mainLocal}" ]; then
	manifest=source/Cargo.toml
	fReadVer() { git show "${1}:${manifest}" 2>/dev/null | sed -n 's/^version *= *"\(.*\)".*/\1/p' | head -1; }
	# fVerGt A B: exit 0 iff A > B by semver precedence (numeric core fields;
	# a prerelease ranks below its release; numeric ids below alphanumeric; ASCII).
	fVerGt() {
		LC_ALL=C awk -v a="${1}" -v b="${2}" '
		function cmp(a, b,   ca, cb, pa, pb, xa, xb, ia, ib, na, nb, m, i, va, vb, x, y, xn, yn) {
			sub(/\+.*/, "", a); sub(/\+.*/, "", b)
			ca = a; pa = ""; if (index(a, "-")) { ca = substr(a, 1, index(a,"-")-1); pa = substr(a, index(a,"-")+1) }
			cb = b; pb = ""; if (index(b, "-")) { cb = substr(b, 1, index(b,"-")-1); pb = substr(b, index(b,"-")+1) }
			na = split(ca, xa, "."); nb = split(cb, xb, ".")
			m = (na > nb) ? na : nb
			for (i = 1; i <= m; i++) {
				va = (i <= na) ? xa[i]+0 : 0; vb = (i <= nb) ? xb[i]+0 : 0
				if (va > vb) return 1; if (va < vb) return -1
			}
			if (pa == "" && pb == "") return 0
			if (pa == "") return 1; if (pb == "") return -1
			na = split(pa, ia, "."); nb = split(pb, ib, ".")
			m = (na < nb) ? na : nb
			for (i = 1; i <= m; i++) {
				x = ia[i]; y = ib[i]; xn = (x ~ /^[0-9]+$/); yn = (y ~ /^[0-9]+$/)
				if (xn && yn) { if (x+0 > y+0) return 1; if (x+0 < y+0) return -1 }
				else if (xn && !yn) return -1
				else if (!xn && yn) return 1
				else { if (x > y) return 1; if (x < y) return -1 }
			}
			if (na > nb) return 1; if (na < nb) return -1
			return 0
		}
		BEGIN { exit (cmp(a, b) > 0) ? 0 : 1 }
		'
	}
	newv=$(fReadVer "${mainLocal}")
	[ -n "${newv}" ] || { echo "pre-push: cannot read version from ${manifest} on the pushed commit" >&2; exit 1; }
	# zero remote sha = main does not exist yet (first push), nothing to compare
	case "${mainRemote}" in
		*[!0]*)
			oldv=$(fReadVer "${mainRemote}")
			if [ -n "${oldv}" ] && ! fVerGt "${newv}" "${oldv}"; then
				echo "pre-push: version ${newv} must be greater than ${oldv} on main - bump ${manifest} (and the README Release badge) before releasing. (SKIP_GATE=1 or --no-verify to override)" >&2
				exit 1
			fi
			;;
	esac
	# README release badge must match the pushed version (shields escapes '-' as '--').
	badgeVer=$(printf '%s' "${newv}" | sed 's/-/--/g')
	if ! git show "${mainLocal}:README.md" 2>/dev/null | grep -qF "Release-${badgeVer}-"; then
		echo "pre-push: README Release badge does not match version ${newv} - update it on dev before the release merge. (SKIP_GATE=1 or --no-verify to override)" >&2
		exit 1
	fi
fi

top="$(git rev-parse --show-toplevel)"

# Private content scrub, on every push, when this machine has the private tree.
# A clone without it pushes as before.
scrub="${top}/../private/hooks/scrub.bash"
if [ -x "${scrub}" ]; then
	"${scrub}" "${top}" || { echo "pre-push: content scrub failed" >&2; exit 1; }
fi

[ "${gated}" = "1" ] || exit 0

echo "pre-push: gating push to main (cicd.bash --gate; --no-verify skips)" >&2
# Gate the commit being pushed, not whatever the working tree holds. Those are
# routinely different here, and a fix still sitting unstaged used to carry the
# push - the gate passed on the tree and main got the version without it. A
# detached worktree is the cheap way to get the real thing. Cargo's output goes
# to the usual place, so only this crate is rebuilt, not its dependencies.
gatedir="$(mktemp -d "${TMPDIR:-/tmp}/silk-gate.XXXXXX")"
tree="${gatedir}/tree"
fCleanup() {
	git -C "${top}" worktree remove --force "${tree}" >/dev/null 2>&1 || :
	rm -rf "${gatedir}"
}
trap fCleanup EXIT INT TERM
git -C "${top}" worktree add --detach -q "${tree}" "${mainLocal}" \
	|| { echo "pre-push: cannot check out ${mainLocal} to gate it" >&2; exit 1; }
CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${top}/target}"
export CARGO_TARGET_DIR
"${tree}/cicd/cicd.bash" --gate

