## Copyright, about, & syntax (minified)
fCopyright(){ { ((doQuietly)) || ((wasShown_Copyright)); } && return; wasShown_Copyright=1;
	fEcho_Clean ""
#	fEcho_Clean "${meName} v${thisVersion} build ${thisBuild},"  ## Don't show version, it may confuse author with version of product being published.
	fEcho_Clean "${meName}, Copyright © ${thisCopyrightYear} ${thisAuthor}."
	fEcho_Clean "Licensed under The MIT License (MIT). Full text at:"
	fEcho_Clean "  https://mit-license.org/"
	fEcho_Clean "No Warranty."
	fEcho_Clean "" ;:;}

fAbout(){ { ((doQuietly)) || ((wasShown_About)); } && return; wasShown_About=1;
	fEcho_Clean ""
	#           X-------------------------------------------------------------------------------X
	fEcho_Clean "Backs up a github directory to a versioned archive, and publishes changes, ie:"
	fEcho_Clean "  • rar {flags} ../versions/{version}.rar  ../*"
	fEcho_Clean "  • git stash push --include-untracked &&  git pull --ff-only  &&  git stash pop"
	fEcho_Clean "  • git add --all  &&  git commit"
	fEcho_Clean "  • git push origin"
	#           X-------------------------------------------------------------------------------X
	fEcho_Clean "" ;:;}

fSyntax(){  { ((doQuietly)) || ((wasShown_Syntax)); } && return; wasShown_Syntax=1;
	fEcho_Clean ""
	#           X-------------------------------------------------------------------------------X
	fEcho_Clean "Arguments:"
	fEcho_Clean "  --message, -m <msg> [also --msg, and -m=<msg>]: Commit message; skips the editor."
	fEcho_Clean "  --quiet, -q [optional]: Be less verbose, and don't prompt user to continue."
	fEcho_Clean "  --no-prompt [optional]: Don't prompt user to continue; everything else as normal."
	fEcho_Clean "  --help, --version [or -h, -v]"
	fEcho_Clean ""
	fEcho_Clean "Environment variables (all optional):"
	fEcho_Clean "  GIT_BACKUP_AND_PUBLISH_QUIET=1        same as --quiet"
	fEcho_Clean "  GIT_BACKUP_AND_PUBLISH_NOBACKUP=1     skip the rar backup, publish only"
	fEcho_Clean "  GIT_BACKUP_AND_PUBLISH_MESSAGE        same as --message"
	fEcho_Clean "  GIT_AUTO_MESSAGE                      same as --message (cicd convention)"
	fEcho_Clean "  GIT_BACKUP_AND_PUBLISH_RAR_EXCLUDES   extra rar patterns, one per line"
	fEcho_Clean "  CPU_CAP                               rar thread cap (-mt)"
	fEcho_Clean ""
	fEcho_Clean "Extra rar patterns can also go in 'cicd/rar-excludes.conf', one per line."
	fEcho_Clean ""
	fEcho_Clean "Expected folder structure - something like:"
	fEcho_Clean "    project-name              [REQUIRED, any name, parent folder]"
	fEcho_Clean "    project-name/github       [REQUIRED, any name, →you should be here←]"
	fEcho_Clean "    project-name/github/.git  [REQUIRED, exact name, created by git]"
	fEcho_Clean "    project-name/priv         [0 to ∞ dirs, included in this backup]"
	fEcho_Clean "    project-name/versions     [REQUIRED, exact name, will be created by this]"

	#           X-------------------------------------------------------------------------------X
	fEcho_Clean "" ;:;}


#••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••••
fMain(){

	## Settings. Symlinks are deliberately followed (no '-ol'): '../private' is itself
	## a link in most projects, and its contents are the point of the backup. Dir
	## links inside the repo, and links back into the project, are dropped below.
	local -a baseCmdArgs=(a -r0 -ep1 -rr -m3)
	## The cicd engines export their core cap; honor it the way every other stage does.
	[[ "${CPU_CAP:-}" =~ ^[0-9]+$ ]] && baseCmdArgs+=("-mt${CPU_CAP}")

	## Generic variables
	local -i wasShown_Copyright=0; local -i wasShown_About=0; wasShown_Syntax=0

	## Check for need to show help. Whole arguments only, and never the value of
	## an option that takes one: matching the joined string took
	## `--message "pass -v through to rar"` as a request for the version.
	{ ((atLeastOneArgRequired)) && [[ -z "${1:-}${2:-}${3:-}${4:-}" ]]; } && { fCopyright; fAbout; fSyntax; return 1; }
	local helpArg=""; local -i skipNext=0
	for helpArg in "${@}"; do
		if ((skipNext)); then skipNext=0; continue; fi
		case "${helpArg,,}" in
			-h|--help)            fCopyright; fAbout; fSyntax; return 0; ;;
			-v|--ver|--version)   fCopyright;                  return 0; ;;
			-m|--msg|--message)   skipNext=1 ;;
		esac
	done

	## Validate dependencies
	fMustBeInPath rar
	fMustBeInPath git

	## Arguments. This script takes no positional args; a stray one is a typo, so throw.
	local -ri parseArgs_maxPositionalArgCount=0  ## Variable expected by fParseArgs()
	fParseArgs  "${@}"

	## Settings; relative paths
	local -r dirPath_GitProj="."
	local -r dirName_GitProj="$(basename "$(readlink -f "${dirPath_GitProj}")")"
	local -r dirPath_Top=".."
	local -r dirName_Top="$(basename "$(readlink -f "${dirPath_Top}")")"
	local -r dirPath_Rar="${dirPath_Top}/versions"
	local -r filePath_Rar="${dirPath_Rar}/${dirName_Top}_${serialDT}.rar"

	## Validate. Before the excludes, which walk '..' for links.
	[[ -f "${dirPath_GitProj}/.git/HEAD" ]]  ||  { fSyntax; fThrowError "Not in git project base directory."; }

	## Backup excludes. Keep what would hurt to lose, drop what a command
	## regenerates. Release builds, installers, packages, source, project docs, and
	## the repo's own assets/ (the README demo gif) all stay in. Every rule here
	## applies to every project, so a name that might be real source elsewhere
	## belongs in that project's own list instead (see the end of this block).
	## How rar 7 matches, as tested:
	##   - A plain dir pattern like '*/foo' drops foo and all it holds, and rar
	##     never walks in. So no 'foo/*' twin; that alone leaves an empty dir.
	##   - '*' spans '/', so '*/target/*/deps' also covers cross-compile trees.
	##   - A wildcard in the last part matches files only. Ending it in '/'
	##     makes it match dirs only.
	##   - 'name.*' also matches a bare 'name', and there are no [...] classes.
	##     That rules out a 'core.*' rule for crash dumps, since it takes core.go
	##     and core.zig with it. An unreadable dump is handled after rar runs.
	##   - Case counts.
	baseCmdArgs+=("-x*/.git" "-x*/versions")
	## Rust: keep the final release binaries, drop debug profiles, lint and doc
	## builds, and every intermediate.
	baseCmdArgs+=("-x*/target/debug" "-x*/target/*/debug" "-x*/target/lint" "-x*/target/clippy" "-x*/target/profiling")
	baseCmdArgs+=("-x*/target/doc")
	baseCmdArgs+=("-x*/target/*/deps" "-x*/target/*/build" "-x*/target/*/incremental" "-x*/target/*/.fingerprint" "-x*/target/*/examples")
	## Cargo's bookkeeping beside the binaries: dep-info, rlibs, locks, toolchain probe.
	baseCmdArgs+=("-x*/target/*.d" "-x*/target/*.rlib" "-x*/target/.*" "-x*/target/*/.cargo-lock" "-x*/CACHEDIR.TAG" "-x*.rs.bk")
	## cargo package unpacks each crate into a versioned dir to test it. The .crate
	## files themselves sit beside those dirs and stay in.
	baseCmdArgs+=("-x*/target/package/*.*.*/")
	## Extra cargo target dirs (pre-push gate, migration checks, benchmark
	## runs) hold debug and test builds only. Dirs only, so a file is never hit.
	baseCmdArgs+=("-x*/target-*/")
	## Python and Node: fetched or regenerated wholesale. 'dist' is deliberately
	## absent - that's where the release packages land.
	baseCmdArgs+=("-x*/__pycache__" "-x*.pyc" "-x*/.venv" "-x*/.mypy_cache" "-x*/.pytest_cache" "-x*/.ruff_cache" "-x*/.hypothesis")
	baseCmdArgs+=("-x*/.tox" "-x*/.nox" "-x*.egg-info/" "-x*/node_modules")
	## Other compiler and build caches, all regenerated on demand.
	baseCmdArgs+=("-x*/.zig-cache" "-x*/zig-cache" "-x*/.ccache" "-x*/.ccls-cache" "-x*/CMakeFiles" "-x*.o" "-x*.gch")
	## Zig dependencies that a fetch step downloads again.
	baseCmdArgs+=("-x*/zig/vendor")
	baseCmdArgs+=("-x*/.cache" "-x*/.gradle" "-x*/.dart_tool" "-x*/.stack-work")
	baseCmdArgs+=("-x*/.next" "-x*/.turbo" "-x*/.parcel-cache" "-x*/.sass-cache")
	## Unreal: build intermediates, shader cache, plugin builds, and cooked and
	## staged copies of the game. The packaged build stays in.
	baseCmdArgs+=("-x*/Intermediate" "-x*/DerivedDataCache" "-x*/Plugins/*/Binaries" "-x*/Saved/Cooked" "-x*/Saved/StagedBuilds")
	## goreleaser leaves each platform's raw binary in its own dir beside the
	## archives and packages that already carry it.
	baseCmdArgs+=("-x*/dist/*_*_amd64_v?/" "-x*/dist/*_*_arm64_v8.?/")
	## Debug builds kept beside the release ones, and profiler dumps.
	baseCmdArgs+=("-x*/bin/*-debug" "-x*/bin/*-debug.exe" "-x*.profraw" "-x*/perf.data*")
	## Wine: a wineprefix is regenerated by wineboot, and its dosdevices map Z: to
	## '/' plus further drives to raw /dev nodes, as symlinks - so following them
	## climbs out of the project and walks the whole filesystem.
	baseCmdArgs+=("-x*/dosdevices" "-x*/drive_c")
	## cicd run output that the next run rewrites: tool logs, profiler output and
	## corpus, GUI probes and captures, throwaway and fuzz builds, a staged
	## Windows runtime, and third-party binaries fetched for size comparison.
	baseCmdArgs+=("-x*/cicd/.profile" "-x*/cicd/artifacts/lint" "-x*/cicd/artifacts/profiling" "-x*/cicd/artifacts/probe")
	baseCmdArgs+=("-x*/cicd/artifacts/wingui" "-x*/cicd/artifacts/runbuilds" "-x*/cicd/artifacts/crosscheck" "-x*/cicd/artifacts/fuzz/build")
	baseCmdArgs+=("-x*/cicd/artifacts/win-run" "-x*/cicd/artifacts/sizebench")
	## Code review snapshots (crMMDD) and gate worktrees. Each is a full copy of
	## the repo, builds included.
	baseCmdArgs+=("-x*/cr0???/" "-x*/cr1???/" "-x*/gatewt-*/")
	## Anything named to stay out of backups, file or dir. The bare pattern takes
	## files only, so each has a '/' twin for dirs.
	baseCmdArgs+=("-x*_dupes" "-x*_dupes/" "-x*_no-backup" "-x*_no-backup/")
	## Older backups, wherever a versions dir sits. Overlaps '*/versions' above.
	baseCmdArgs+=("-x*/versions/*.rar")
	## The linked-in vault of external resources (GBs of game assets and the like).
	baseCmdArgs+=("-x*/assets-vault")
	## Archived material, tmp dirs, and asset zips already imported into the game.
	baseCmdArgs+=("-x*/0_archive" "-x*/tmp" "-x*/.tmp" "-x*/Content/_staging/*/_done")
	## Hand-made backup copies, merge and editor leftovers, and one-off probe
	## scripts. Not '*.orig': vendored crates ship a Cargo.toml.orig. Not '*.rar'
	## either: a project may keep a real archive on purpose.
	baseCmdArgs+=("-x*.bak" "-x*.bak-*" "-x*.rej" "-x*~" "-x*.swp" "-x*.tmp" "-x*/.probe-*")
	## GFS-rotated history (demo gifs/videos, logs). Matching the timestamp+role
	## shape that gfs-rotate.bash writes keeps this to its own output, and the
	## newest of each set is named '_latest', which is deliberately not listed.
	local gfsRole=""
	for gfsRole in first frequent hour day week month year; do baseCmdArgs+=("-x*_????????-??????_${gfsRole}.*"); done
	## Project-specific excludes, for big regenerable trees only this project knows
	## about. Two sources, both optional and additive:
	##   - cicd/rar-excludes.conf, read from disk so it applies however this
	##     script is entered: via the pipeline, or run standalone.
	##   - GIT_BACKUP_AND_PUBLISH_RAR_EXCLUDES, set by the cicd config.
	local -r filePath_Excludes="${dirPath_GitProj}/cicd/rar-excludes.conf"
	if [[ -r "${filePath_Excludes}" ]]; then fAddRarExcludes < "${filePath_Excludes}" || return 1; fi
	if [[ -n "${GIT_BACKUP_AND_PUBLISH_RAR_EXCLUDES:-}" ]]; then fAddRarExcludes <<< "${GIT_BACKUP_AND_PUBLISH_RAR_EXCLUDES}" || return 1; fi
	## A dir link inside the repo brings in outside data, such as asset packs
	## linked into a game's Content, which git doesn't hold either. A link back
	## into the project would archive the same files twice. Links beside the repo
	## that point out of the project, like '../private', are still followed.
	fAddLinkExcludes "${dirPath_Top}" "${dirName_GitProj}" || return 1
	local -a cmd_Rar=(rar "${baseCmdArgs[@]}" "${filePath_Rar}" "../.")
	local -r cmd_Rar_display="rar ${baseCmdArgs[*]}  '${filePath_Rar}'  '../.'"

	## Prompt to continue
	if ((! doQuietly)); then
		fCopyright
		fAbout
		if ((! skipBackup)); then
			fEcho_Clean "Archive source ...............: ${dirPath_GitProj}"
			fEcho_Clean "Archive target ...............: ${filePath_Rar}"
			fEcho_Clean
			fEcho_Clean "Rar command:"
			fEcho_Clean "${cmd_Rar_display}"
			fEcho_Clean
		fi
		fEcho_Clean "Remote info (git remote -v); make sure it's 'git@' and not 'https://':"
		git remote -v
		fEcho_Clean
		fEcho_Clean "Current branch (git branch --show-current):"
		git branch --show-current
		fEcho_Clean
		fEcho_Clean "git user info:"
		## Unset is a plain answer here, not a fatal error: git config exits 1 on
		## a missing key, and set -e would end the run before anything happened.
		git config user.name  || echo "(user.name not set)"
		git config user.email || echo "(user.email not set)"
		fEcho_Clean
		fEcho_Clean "SSH key being used"
		## Test the repo's actual remote host, not a hardcoded one, so the
		## per-repo ssh alias/key is exercised (a generic github.com falls
		## back to default key resolution and can report the wrong account).
		## Handle every remote form: ssh:// scheme, scp-style git@host:path,
		## and a bare alias:path with no user@ (the ssh-config Host supplies
		## it) - the old '.*@' pattern silently failed on that last one.
		local sshHost; sshHost="$(git remote get-url origin 2>/dev/null | sed -E 's|^[a-z][a-z0-9+.-]*://||; s|^[^@/]*@||; s|[:/].*$||' || true)"
		ssh -nTv git@${sshHost:-github.com} 2>&1 | grep -iE "offering|successfully authenticated" | sed 's/debug1: //' || true  ## -n: don't read stdin, else it eats the next prompt's input
		fIntroPromptToContinue  ""
		fEcho_Clean
	fi

	## Make backup dir
	if ((! skipBackup)); then
		[[ -d "${dirPath_Rar}" ]]  ||  mkdir -p "${dirPath_Rar}"

		fEcho "Creating version backup '${filePath_Rar}' ..."
		## Exit 6 means rar could not open some files, and it archived the rest.
		## That's usually a dangling symlink, or a crash dump from a container or a
		## root process, which is root-owned and mode 0600. It shouldn't stop a
		## publish, so say so loudly and carry on. Any other failure stops here.
		local -i rarRc=0
		"${cmd_Rar[@]}" || rarRc=$?
		if ((rarRc == 6)) && [[ -s "${filePath_Rar}" ]]; then
			fEcho_Force "WARNING: rar could not read the files it named above, and left them out of the backup."
		elif ((rarRc)); then
			fThrowError "rar failed with exit ${rarRc}. Nothing was committed or pushed."
			return 1
		fi

		## Prune old backups (GFS): keep ~30 - first + newest-per-
		## hour/day/week/month/year + the last 10. Also conforms pre-existing
		## backup names. Tunable via GFS_KEEP_* env (see include/gfs-rotate.bash).
		fEcho; fEcho "Rotating version backups (GFS retention) ..."
		## Non-fatal: pruning is housekeeping and must never abort a good publish.
		if declare -F gfs_rotate >/dev/null 2>&1; then
			gfs_rotate "${dirPath_Rar}" "${dirName_Top}" rar || fEcho "WARNING: backup rotation failed (non-fatal); continuing."
		else
			fEcho "WARNING: include/gfs-rotate.bash not found; skipping rotation."
		fi
	fi

	## A stash left by a run that stopped between its stash and its pop holds
	## uncommitted work. Publishing past it prints "Done." with the work still
	## stashed, and the next stash buries it deeper.
	if grep -qE ': auto-stash$' <<< "$(git stash list)"; then
		fThrowError "an 'auto-stash' from an earlier run is still in 'git stash list'. Pop or drop it, then re-run. Nothing was committed or pushed."
		return 1
	fi

	## Variables for git actions
	local -i didStash=0
	local -i preCount
	local -i postCount

	## Stash. Untracked counts too - the stash includes them, and a pull that
	## brings in a file already sitting here untracked aborts otherwise, after the
	## backup has already run.
	if ! git diff --quiet || ! git diff --cached --quiet || \
	   [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
		fEcho; fEcho "git stash push --include-untracked..."
		preCount=$(git stash list | wc -l)
		git stash push --include-untracked -m "auto-stash"
		postCount=$(git stash list | wc -l)
		didStash=$((postCount > preCount ? 1 : 0))
	fi

	## Sync with this branch's upstream if it has one. A brand-new local branch
	## has nothing to pull; the push below sets its upstream on first publish.
	if git rev-parse --abbrev-ref @{u} >/dev/null 2>&1; then
		fEcho; fEcho "git pull --ff-only ..."
		## ff-only per the house rule: a divergent upstream stops here loudly
		## instead of auto-merging behind the publish. A failed pull puts the
		## stash back first: left there, the next run finds a clean tree and
		## publishes without the work.
		if ! fGitRemote pull --ff-only; then
			if ((didStash)) && ! git stash pop; then
				fThrowError "git pull --ff-only failed, and putting the stashed work back conflicted. Resolve it, then 'git stash drop'. Nothing was committed or pushed."
				return 1
			fi
			fThrowError "git pull --ff-only failed. The working tree is as it was. Nothing was committed or pushed."
			return 1
		fi
	fi

	## Stash pop. A conflict here leaves the tree with markers and keeps the
	## stash entry; set -e treats git's exit 1 as a clean exit, so left alone it
	## silently strands a half-merged tree. Catch it, say what to do, and stop
	## before anything gets staged, committed, or pushed.
	if ((didStash)); then
		fEcho; fEcho "git stash pop ..."
		if ! git stash pop; then
			fThrowError "stash pop conflicted after pull. Resolve the conflicts, then 'git stash drop', and re-run. Nothing was committed or pushed."
			return 1
		fi
	fi

	## Never publish an unresolved merge: 'git add --all' would happily stage a
	## conflict-marked file as resolved. Bail on any unmerged path first.
	if [[ -n "$(git ls-files --unmerged)" ]]; then
		fThrowError "unmerged paths present; refusing to stage or publish. Resolve them and re-run."
		return 1
	fi

	# Stage everything tracked/new (still honors .gitignore).
	fEcho; fEcho "git add --all ..."
	git add --all

	if ! git diff --cached --quiet; then
		fEcho; fEcho "git commit ..."
		## Message precedence: --message (or either message env) wins; otherwise when
		## quiet, auto-generate one so an unattended run never blocks on an editor;
		## otherwise open the editor as usual.
		if   [[ -n "${commitMessage}" ]]; then git commit -m "${commitMessage}"
		elif ((doQuietly));               then git commit -m "$(fAutoMessage "${dirName_Top} ${serialDT}")"
		else                                   git commit
		fi
	fi

	# Push only if we're ahead of the remote
	if ! git rev-parse --abbrev-ref @{u} >/dev/null 2>&1; then
		fEcho; fEcho "git push -u origin HEAD ..."
		fGitRemote push -u origin HEAD
	elif [[ -n "$(git log @{u}.. 2>/dev/null)" ]]; then
		fEcho; fEcho "git push origin ..."
		fGitRemote push origin
	fi

	## Done
	if ((! doQuietly)); then fEcho_Force; fEcho "${meName}: Done."; fi
:;}

## Reads extra rar excludes on stdin and adds them to baseCmdArgs. Two forms:
##   - One bare pattern per line, taken as is. Blank lines and lines starting
##     with '#' are skipped.
##   - The older quoted list, e.g. "-x'*/a' '-x*/b'", on one or more lines. A
##     line starting with -x, or a quote then -x, is split by xargs, which drops
##     the quotes but runs nothing. The value comes from the caller's
##     environment, and this script goes on to commit and push.
fAddRarExcludes(){
	local line="" split="" word=""; local -a words=()
	while IFS= read -r line || [[ -n "${line}" ]]; do
		line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
		[[ -z "${line}" || "${line}" == \#* ]] && continue
		if [[ "${line}" == -x* || "${line}" == [\'\"]-x* ]]; then
			split="$(xargs -r printf '%s\n' <<< "${line}")" || { fThrowError "Can't split rar exclude line: ${line}"; return 1; }
			mapfile -t words <<< "${split}"
			for word in "${words[@]}"; do [[ -n "${word}" ]] && baseCmdArgs+=("-x${word#-x}"); done
		else
			baseCmdArgs+=("-x${line}")
		fi
	done
:;}

## Adds an exact rar exclude for each dir link under the archive root ($1) that
## sits inside the repo (named $2) or resolves back into the root. rar matches a
## pattern with no wildcard from the top of the archive, so 'github/a/b' leaves
## out that one link and nothing else of the same name.
fAddLinkExcludes(){
	local -r dirPath_Root="$1"
	local -r dirName_Repo="$2"
	local rootReal=""; rootReal="$(readlink -f "${dirPath_Root}")" || { fThrowError "Can't resolve ${dirPath_Root}"; return 1; }
	local -a linkPaths=() targetPaths=()
	mapfile -d '' linkPaths < <(find "${dirPath_Root}/" \( -name .git -o -name versions \) -prune -o -type l -xtype d -print0)
	((${#linkPaths[@]})) || return 0
	mapfile -d '' targetPaths < <(realpath -z -- "${linkPaths[@]}")
	((${#targetPaths[@]} == ${#linkPaths[@]})) || { fThrowError "Can't resolve the dir links under ${dirPath_Root}"; return 1; }
	local -i i=0; local relPath=""
	for ((i = 0; i < ${#linkPaths[@]}; i++)); do
		relPath="${linkPaths[i]#"${dirPath_Root}/"}"
		if [[ "${relPath}" == "${dirName_Repo}/"* || "${targetPaths[i]}/" == "${rootReal}/"* ]]; then baseCmdArgs+=("-x${relPath}"); fi
	done
:;}

## The message an unattended commit lands under. A sibling git-auto-msg.bash that
## knows '--suggest' writes it, so the pipeline and this script can't drift apart.
## Older copies of that helper don't, so they get the fallback in $1.
## Git that talks to the remote goes through gitsby where it is installed, so the
## pull and push use the key and account the repo belongs to. Plain git without it.
fGitRemote(){ if command -v gitsby >/dev/null 2>&1; then gitsby raw git "$@"; else git "$@"; fi; }

fAutoMessage(){
	local -r helper="${meDir}/git-auto-msg.bash"
	if [[ -x "${helper}" ]] && grep -qF -- '--suggest' "${helper}"; then bash "${helper}" --suggest
	else                                                             echo "${1:-Updated}"
	fi ;}

