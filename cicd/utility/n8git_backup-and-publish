## Settings
[[ -v doQuietly              ]] || declare  -i doQuietly=0                ; [[ "${GIT_BACKUP_AND_PUBLISH_QUIET:-0}" == "1" ]] && doQuietly=1
[[ -v doPromptToContinue     ]] || declare  -i doPromptToContinue=1
[[ -v thisVersion            ]] || declare -r  thisVersion="1.0.0-beta3"
[[ -v thisBuild              ]] || declare -r  thisBuild="1n0rx7c"
[[ -v thisCopyrightYear      ]] || declare -r  thisCopyrightYear="2026"
[[ -v thisAuthor             ]] || declare -r  thisAuthor="Bubbles"
[[ -v atLeastOneArgRequired  ]] || declare -ri atLeastOneArgRequired=0
[[ -v skipBackup             ]] || declare  -i skipBackup=0               ; [[ "${GIT_BACKUP_AND_PUBLISH_NOBACKUP:-0}" == "1" ]] && skipBackup=1
## Commit message, lowest precedence first: the cicd engines drive us with
## GIT_AUTO_MESSAGE, and '--message' (parsed later) overrides either env.
[[ -v commitMessage          ]] || declare     commitMessage=""           ; [[ -n "${GIT_AUTO_MESSAGE:-}" ]]                  && commitMessage="${GIT_AUTO_MESSAGE}"
[[ -n "${GIT_BACKUP_AND_PUBLISH_MESSAGE:-}" ]] && commitMessage="${GIT_BACKUP_AND_PUBLISH_MESSAGE}"

